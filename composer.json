{
    "name": "kode/runtime",
    "description": "现代 PHP 常驻内存应用的统一运行时抽象层 | 支持 Swoole、Swow、PHP Fiber、多进程、多线程、Console 及传统 CLI 模式，基于 PHP 8.3+ 新特性构建",
    "keywords": ["runtime", "swoole", "swow", "fiber", "coroutine", "async", "parallel", "php", "console"],
    "version": "3.3.0",
    "type": "library",
    "license": "Apache-2.0",
    "authors": [
        {
            "name": "Kode Team",
            "email": "382601296@qq.com"
        }
    ],
    "require": {
        "php": "^8.3",
        "kode/context": "^3.0",
        "kode/console": "^4.0"
    },
    "suggest": {
        "ext-swoole": "使用 Swoole 协程引擎（4.8+）",
        "ext-swow": "使用 Swow 协程引擎（1.5+）",
        "ext-pcntl": "启用多进程运行时",
        "ext-parallel": "启用多线程运行时（需 ZTS 版本 PHP）"
    },
    "require-dev": {
        "phpunit/phpunit": "^12.0",
        "squizlabs/php_codesniffer": "^3.6"
    },
    "autoload": {
        "psr-4": {
            "Kode\\Runtime\\": "src/"
        },
        "files": [
            "src/functions.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Kode\\Runtime\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "cs-check": "phpcs --standard=PSR12 src/ tests/",
        "cs-fix": "phpcbf --standard=PSR12 src/ tests/"
    },
    "extra": {
        "branch-alias": {
            "dev-main": "3.3-dev"
        }
    },
    "config": {
        "sort-packages": true
    }
}
